# Sample systemd unit for the ecv3 server (production).
#
# This is a TEMPLATE — review paths/ports before deploying.
#
# One-time host setup:
#   sudo groupadd --system ecv3
#   sudo useradd  --system --gid ecv3 --no-create-home --shell /usr/sbin/nologin ecv3
#   sudo mkdir -p /opt/ecv3/bin /opt/ecv3/data
#   sudo install -m 0755 ec /opt/ecv3/bin/ec            # the built binary (make build -> ./ec)
#   sudo chown -R ecv3:ecv3 /opt/ecv3
#   sudo chmod 0750 /opt/ecv3/data
#
# Create the database ONCE (the data dir must already exist; serve only opens,
# it never creates). Run as the service user so the files are owned correctly:
#   sudo -u ecv3 /opt/ecv3/bin/ec database create /opt/ecv3/data
#
# Install + enable the service:
#   sudo install -m 0644 dist/ecv3.service /etc/systemd/system/ecv3.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ecv3.service
#   journalctl -u ecv3 -f            # follow logs

[Unit]
Description=ecv3 4X strategy game server
Documentation=https://github.com/mdhender/ecv3
After=network-online.target
Wants=network-online.target

# Maintenance gate: if /opt/ecv3/MAINTENANCE exists, the start is skipped
# (the leading "!" negates the check). A failed condition is logged and treated
# as success, so the unit isn't marked failed. To take the service down for a
# maintenance window:
#   sudo touch /opt/ecv3/MAINTENANCE && sudo systemctl stop ecv3
# and to bring it back:
#   sudo rm /opt/ecv3/MAINTENANCE && sudo systemctl start ecv3
ConditionPathExists=!/opt/ecv3/MAINTENANCE

[Service]
Type=simple
User=ecv3
Group=ecv3
WorkingDirectory=/opt/ecv3
ExecStart=/opt/ecv3/bin/ec serve

# Configuration via environment. The binary reads PORT (defaults to 8080) and
# ECV3_DATA, the directory holding the SQLite database (<data>/ecv3.db). serve
# opens that database on startup and exits non-zero if it is missing, so run
# `ec database create /opt/ecv3/data` once before the first start (see above).
Environment=PORT=8080
Environment=ECV3_DATA=/opt/ecv3/data

Restart=on-failure
RestartSec=5s

# Logging to journald (view with: journalctl -u ecv3)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecv3

# --- Sandboxing / hardening -------------------------------------------------
# The service runs unprivileged and needs to write only the data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ecv3/data
UMask=0077

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true

# Listening on :8080 needs no extra capabilities, so drop them all.
# If you later bind a privileged port (e.g. :443 via autocert), instead set:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=

# AF_NETLINK is used by Go's net package for interface lookups.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
